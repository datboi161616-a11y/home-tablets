diff --git a/src/tablet/defaults.js b/src/tablet/defaults.js
new file mode 100644
index 0000000..dcd031b
--- /dev/null
+++ b/src/tablet/defaults.js
@@ -0,0 +1,36 @@
+/**
+ * @module tablet/defaults
+ * @description Lighter starting values for a small tablet. Each is a setting
+ * the app already has, set through the app's own actions at a fresh start, so
+ * every one can be changed back from the app's own panels: nothing is taken
+ * away.
+ */
+import { startedFresh } from './profile.js';
+
+/**
+ * The starting values, applied on a fresh start. The app keeps these in the
+ * page's link rather than in storage, so a fresh start has its desktop
+ * defaults again.
+ * @param {object} options
+ * @param {(name: string, args?: object) => Promise<object>} options.run The
+ *   app's action runner.
+ * @param {boolean} [options.fresh] Whether this is a fresh start (see
+ *   `startedFresh` in `profile.js`).
+ * @returns {Promise<boolean>} Whether they were applied.
+ */
+export async function applyStartingValues({ run, fresh = startedFresh }) {
+  if (!fresh) return false;
+  const act = async (name, args) => {
+    try {
+      return await run(name, args);
+    } catch {
+      return null;
+    }
+  };
+  // A full-screen sharpening pass costs a weak graphics chip a second trip
+  // over every pixel, each frame.
+  await act('set_post_processing', { sharpen: { enabled: false } });
+  // The calmer of the app's two heads-up displays.
+  await act('set_hud', { layout: 'minimal' });
+  return true;
+}
diff --git a/src/tablet/governor.js b/src/tablet/governor.js
new file mode 100644
index 0000000..badc0bd
--- /dev/null
+++ b/src/tablet/governor.js
@@ -0,0 +1,505 @@
+/**
+ * @module tablet/governor
+ * @description Keeps the globe moving smoothly on a weak graphics chip by
+ * trading sharpness for frame rate, through the renderer's own quality port
+ * (`src/render/contract/quality.d.ts`). The stock app never turns those
+ * knobs; on a desktop GPU it has no need to.
+ *
+ * How it decides. While something animates (the loop is in `continuous`
+ * mode) it measures the time between drawn frames, once a second. Whether a
+ * slow picture is the graphics chip's doing (fewer pixels help) or the
+ * processor's (they do not) cannot be read off a tablet, so every step is a
+ * trial that has to earn its keep:
+ *
+ * - slower than `SLOW` of the target for a few seconds: step DOWN the ladder
+ *   (a lower internal resolution, and terrain to match it) and see what it
+ *   buys. A step that does not make the picture faster is taken back, and the
+ *   rungs below are left alone for a while: sharpness is not thrown away for
+ *   nothing.
+ * - slow, and stepping down does not help: step UP instead. If the rate holds,
+ *   the sharper picture was free, and it climbs again.
+ * - at the target with processor time to spare for a good while: step UP one
+ *   rung to see whether the chip can afford it (a frame-rate cap hides how
+ *   much room it has).
+ * - a step up that costs frame rate is taken back, and that rung left alone
+ *   for a while, longer each time it fails.
+ *
+ * Frames drawn on demand (a parked camera, nothing moving) say nothing about
+ * speed and are ignored. The rung it settles on is remembered for next start.
+ * What was learned about one scene says little about the next: whoever
+ * changes the scene says so (`newScene`), and the rungs left alone are open
+ * again.
+ *
+ * Sharp when still. A picture that is not moving has all the time it needs, so
+ * once the animation has stopped for `STILL_AFTER_MS` (the loop's last frame
+ * was one drawn on demand: on a slow chip an animation's frames can be further
+ * apart than that, and are still an animation) the governor gives it
+ * the stock app's resolution and full terrain detail (the finer tiles load in
+ * as they would in the stock app), and drops back to the rung on the first
+ * frame of the next movement; the coarser tiles are still in memory, so that
+ * costs no loading. Should sharpening ever set the picture moving again by
+ * itself (movement comes straight after it, several times within seconds), it
+ * is left off for a while. Whoever is busy changing the view (a mission being
+ * set up) can ask for no sharpening meanwhile (`allowStills`).
+ *
+ * The decision logic keeps no clock or storage of its own (both are passed
+ * in), so it runs under Node in `governor.test.mjs`.
+ */
+
+/**
+ * Best to worst. `pixelRatio` scales the drawing buffer; detail is 0..1.
+ *
+ * Cesium picks tiles for the screen's size whatever the buffer's, so a lower
+ * pixel ratio alone draws more map detail than its pixels can show. Down to
+ * the fourth rung the terrain detail is the one that matches the pixel ratio
+ * (an error `1 / pixelRatio` times the stock one, see `errorFactor` in
+ * `src/render/cesium/quality.js`): the picture loses what the lower
+ * resolution loses and nothing more, for fewer tiles to draw, load and keep.
+ * The last two rungs go further, for a chip that still cannot keep up.
+ */
+export const LADDER = Object.freeze([
+  Object.freeze({ pixelRatio: 1, terrainDetail: 1 }),
+  Object.freeze({ pixelRatio: 0.85, terrainDetail: 0.92 }),
+  Object.freeze({ pixelRatio: 0.75, terrainDetail: 0.86 }),
+  Object.freeze({ pixelRatio: 0.65, terrainDetail: 0.79 }),
+  Object.freeze({ pixelRatio: 0.55, terrainDetail: 0.66 }),
+  Object.freeze({ pixelRatio: 0.5, terrainDetail: 0.52 }),
+]);
+
+export const QUALITY_STORAGE_KEY = 'gev:tablet:quality:v1';
+
+/** Below this share of the target rate counts as slow. */
+const SLOW = 0.72;
+/** At or above this share of the target rate counts as on target. */
+const FAST = 0.93;
+/** Slow seconds in a row before stepping down. */
+const DOWN_AFTER = 3;
+/** Slow seconds in a row, with no rung below to try, before stepping up. */
+const UP_AFTER_SLOW = 10;
+/** On-target seconds in a row before trying a better rung. */
+const UP_AFTER = 20;
+/** No decision this soon after a change: tiles reload and frames stutter. */
+const COOLDOWN_MS = 5_000;
+/** Seconds measured, after the cooldown, to judge a step. */
+const TRIAL_SECONDS = 3;
+/** A step down has helped when the rate is this many times what it was. */
+const HELPED = 1.08;
+/** A step up from a rate on target has cost too much below this share of it. */
+const HELD = 0.93;
+/** A step up from a slow rate must cost next to nothing. */
+const HELD_WHEN_SLOW = 0.95;
+/** A gap this long between frames is a pause, not a slow frame. */
+const PAUSE_MS = 400;
+/** Frames in a second needed to judge it. */
+const MIN_SAMPLES = 5;
+/** Seconds of frame rate remembered, to compare a step against. */
+const RECENT_SECONDS = 3;
+/** Processor share of a frame's budget above which a better rung is not tried. */
+const BUSY = 0.7;
+/** Stillness before the picture is redrawn sharp. */
+export const STILL_AFTER_MS = 900;
+/** Movement this soon after sharpening may have been caused by it. */
+const ECHO_MS = 400;
+/**
+ * That many times within the window, and sharpening is left off for a while.
+ * A loop the sharpening itself drives comes round every second or two;
+ * movement that only happens to follow a sharpening does not keep that up.
+ */
+const ECHO_LIMIT = 3;
+const ECHO_WINDOW_MS = 8_000;
+const STILL_OFF_MS = 5 * 60_000;
+/** How long rungs are left alone after a failed step; doubles to the longest. */
+const BACKOFF_MS = 5 * 60_000;
+const LONGEST_BACKOFF_MS = 40 * 60_000;
+
+const WORST = LADDER.length - 1;
+const mean = (list) => list.reduce((sum, n) => sum + n, 0) / list.length;
+const clampLevel = (n) =>
+  Math.min(WORST, Math.max(0, Math.round(Number(n) || 0)));
+
+/** The rung remembered from an earlier run, or null. */
+export function readStoredLevel(storage) {
+  try {
+    const parsed = JSON.parse(
+      storage?.getItem?.(QUALITY_STORAGE_KEY) || 'null',
+    );
+    return Number.isInteger(parsed?.level) ? clampLevel(parsed.level) : null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * @param {object} options
+ * @param {import('../render/contract/quality').QualityPort} options.quality
+ * @param {number} [options.targetFps] The rate to hold, and the loop's cap.
+ * @param {number} [options.startLevel] The rung to start on with none remembered.
+ * @param {() => number} [options.now] Milliseconds, monotonic.
+ * @param {{getItem: Function, setItem: Function}|null} [options.storage]
+ * @param {(change: object) => void} [options.onChange] Told of each change:
+ *   a step on the ladder (`reason` 'start', 'slow', 'probe', 'no-gain',
+ *   'too-much', 'new-scene' or 'pinned'), a still picture sharpened
+ *   ('still'), and
+ *   movement after one ('moving', with how soon it came and what was holding
+ *   the loop).
+ * @param {number} [options.stillPixelRatio] The resolution a still picture is
+ *   redrawn at: 1 is the stock app's (one pixel per CSS pixel). The rung's own
+ *   or less turns sharp-when-still off.
+ * @param {(fn: Function, ms: number) => unknown} [options.schedule] A timer.
+ * @param {(timer: unknown) => void} [options.cancel]
+ */
+export function createQualityGovernor({
+  quality,
+  targetFps = 30,
+  startLevel = 2,
+  now = () => performance.now(),
+  storage = null,
+  onChange = null,
+  stillPixelRatio = 1,
+  schedule = (fn, ms) => setTimeout(fn, ms),
+  cancel = (timer) => clearTimeout(timer),
+}) {
+  if (!quality?.set || !quality?.signals?.on)
+    throw new TypeError('A quality port is required');
+
+  let level = readStoredLevel(storage) ?? clampLevel(startLevel);
+  /** The best rung allowed while a failed step up's back-off runs. */
+  let ceiling = 0;
+  let ceilingUntil = 0;
+  let ceilingBackoff = BACKOFF_MS;
+  /** The worst rung allowed while a failed step down's back-off runs. */
+  let floor = WORST;
+  let floorUntil = 0;
+  let floorBackoff = BACKOFF_MS;
+  /** The step being judged: {kind: 'down'|'up', from, fpsBefore, slow, seconds}. */
+  let trial = null;
+  let lastChangeAt = now();
+  let lastContinuousAt = null;
+  let windowStart = now();
+  let intervals = [];
+  let work = [];
+  /** The frame rate of the last few judged seconds, newest last. */
+  let recent = [];
+  let slowStreak = 0;
+  let fastStreak = 0;
+  let measured = { fps: null, cpuMs: null, gpuMs: null };
+  let changes = 0;
+  let stopped = false;
+  /** Whether the picture on screen is the sharp still. */
+  let sharp = false;
+  let sharpenedAt = 0;
+  let lastMotionAt = null;
+  /** The mode of the last frame drawn: 'continuous', 'demand', or none yet. */
+  let lastMode = null;
+  let stillTimer = null;
+  /** When movement last came straight after a sharpening, oldest first. */
+  let echoes = [];
+  let stillOffUntil = 0;
+  let stillsAllowed = true;
+  /** Whether the rung is held where it was put, for measuring one. */
+  let held = false;
+
+  const budgetMs = 1000 / targetFps;
+  const ceilingNow = (t) => (t < ceilingUntil ? ceiling : 0);
+  const floorNow = (t) => (t < floorUntil ? floor : WORST);
+
+  function apply(reason) {
+    const rung = LADDER[level];
+    sharp = false;
+    quality.set({
+      pixelRatio: rung.pixelRatio,
+      terrainDetail: rung.terrainDetail,
+      tiles3dDetail: rung.terrainDetail,
+      msaa: 0,
+      targetFps,
+    });
+    try {
+      storage?.setItem?.(QUALITY_STORAGE_KEY, JSON.stringify({ level }));
+    } catch {
+      /* storage full or off: the rung is simply not remembered */
+    }
+    changes += 1;
+    onChange?.({ level, reason, ...rung, ...measured });
+  }
+
+  /** Move to `next` and start counting afresh from `t`. */
+  function moveTo(next, t, reason) {
+    level = next;
+    slowStreak = 0;
+    fastStreak = 0;
+    recent = [];
+    lastChangeAt = t;
+    apply(reason);
+  }
+
+  /** Take one step and judge it once the picture has settled. */
+  function startTrial(kind, t) {
+    trial = {
+      kind,
+      from: level,
+      fpsBefore: mean(recent),
+      slow: slowStreak > 0,
+      seconds: [],
+    };
+    moveTo(
+      level + (kind === 'down' ? 1 : -1),
+      t,
+      kind === 'down' ? 'slow' : 'probe',
+    );
+  }
+
+  /** The step has been measured for long enough: keep it or take it back. */
+  function judgeTrial(t) {
+    const { kind, from, fpsBefore, slow, seconds } = trial;
+    const after = mean(seconds);
+    trial = null;
+    if (kind === 'down') {
+      if (after >= fpsBefore * HELPED) {
+        floorBackoff = BACKOFF_MS;
+        return;
+      }
+      // Fewer pixels bought nothing: the processor is what is slow.
+      floor = from;
+      floorUntil = t + floorBackoff;
+      floorBackoff = Math.min(floorBackoff * 2, LONGEST_BACKOFF_MS);
+      moveTo(from, t, 'no-gain');
+      return;
+    }
+    const held =
+      after >= fpsBefore * (slow ? HELD_WHEN_SLOW : HELD) &&
+      (slow || after >= targetFps * SLOW);
+    if (held) {
+      ceilingBackoff = BACKOFF_MS;
+      // Going back down from here is known not to help.
+      if (slow && t < floorUntil) floor = level;
+      return;
+    }
+    ceiling = from;
+    ceilingUntil = t + ceilingBackoff;
+    ceilingBackoff = Math.min(ceilingBackoff * 2, LONGEST_BACKOFF_MS);
+    moveTo(from, t, 'too-much');
+  }
+
+  function evaluate(t) {
+    const samples = intervals;
+    const cpu = work;
+    intervals = [];
+    work = [];
+    windowStart = t;
+    if (samples.length < MIN_SAMPLES) return;
+    const fps = 1000 / mean(samples);
+    const cpuMs = mean(cpu.map((w) => w.cpuMs));
+    const gpu = cpu.map((w) => w.gpuMs).filter((n) => Number.isFinite(n));
+    const gpuMs = gpu.length ? mean(gpu) : null;
+    measured = { fps, cpuMs, gpuMs };
+    if (held || t - lastChangeAt < COOLDOWN_MS) return;
+    if (trial) {
+      trial.seconds.push(fps);
+      if (trial.seconds.length >= TRIAL_SECONDS) judgeTrial(t);
+      return;
+    }
+    recent.push(fps);
+    if (recent.length > RECENT_SECONDS) recent.shift();
+    if (fps < targetFps * SLOW) {
+      fastStreak = 0;
+      slowStreak += 1;
+      if (slowStreak >= DOWN_AFTER && level < floorNow(t)) {
+        startTrial('down', t);
+      } else if (
+        slowStreak >= UP_AFTER_SLOW &&
+        level >= floorNow(t) &&
+        level > ceilingNow(t)
+      ) {
+        // No rung below is worth trying: is a sharper one free?
+        startTrial('up', t);
+      }
+      return;
+    }
+    slowStreak = 0;
+    if (fps < targetFps * FAST) {
+      fastStreak = 0;
+      return;
+    }
+    fastStreak += 1;
+    const spent = cpuMs + (gpuMs ?? 0);
+    if (
+      fastStreak >= UP_AFTER &&
+      level > ceilingNow(t) &&
+      spent < budgetMs * BUSY
+    )
+      startTrial('up', t);
+  }
+
+  /** Starts the wait for stillness, unless one is already running. */
+  function watchForStill(delay = STILL_AFTER_MS) {
+    if (stopped || stillTimer !== null) return;
+    stillTimer = schedule(onStillTimer, delay);
+  }
+
+  /** The wait is over: redraw the picture sharp if nothing moved meanwhile. */
+  function onStillTimer() {
+    stillTimer = null;
+    if (stopped || sharp) return;
+    // Still animating when it last drew, however far apart its frames come:
+    // the next frame starts the wait again.
+    if (lastMode === 'continuous') return;
+    const t = now();
+    const quietFor = lastMotionAt === null ? Infinity : t - lastMotionAt;
+    if (quietFor < STILL_AFTER_MS) {
+      // Never a wait of next to nothing: a clock's rounding must not spin it.
+      watchForStill(Math.max(50, STILL_AFTER_MS - quietFor));
+      return;
+    }
+    if (!stillsAllowed || t < stillOffUntil) return;
+    if (stillPixelRatio <= LADDER[level].pixelRatio) return;
+    sharp = true;
+    sharpenedAt = t;
+    quality.set({
+      pixelRatio: stillPixelRatio,
+      terrainDetail: 1,
+      tiles3dDetail: 1,
+    });
+    onChange?.({ level, reason: 'still', pixelRatio: stillPixelRatio });
+  }
+
+  /** Movement again: back to the rung's resolution. */
+  function unsharpen(t, signal) {
+    sharp = false;
+    if (t - sharpenedAt < ECHO_MS) {
+      echoes = echoes.filter((at) => t - at < ECHO_WINDOW_MS);
+      echoes.push(t);
+      if (echoes.length >= ECHO_LIMIT) {
+        echoes = [];
+        stillOffUntil = t + STILL_OFF_MS;
+      }
+    }
+    const rung = LADDER[level];
+    quality.set({
+      pixelRatio: rung.pixelRatio,
+      terrainDetail: rung.terrainDetail,
+      tiles3dDetail: rung.terrainDetail,
+    });
+    onChange?.({
+      level,
+      reason: 'moving',
+      ...rung,
+      afterMs: Math.round(t - sharpenedAt),
+      holds: signal?.holds ?? [],
+      sharpStillOff: t < stillOffUntil,
+    });
+  }
+
+  /**
+   * Forget the frames timed so far: a steady spell is unbroken animation, and
+   * a step is judged against the same animation it was taken in.
+   */
+  function startOver(t) {
+    intervals = [];
+    work = [];
+    windowStart = t;
+    slowStreak = 0;
+    fastStreak = 0;
+    recent = [];
+    if (trial) trial.seconds = [];
+  }
+
+  function onFrame(signal) {
+    if (stopped) return;
+    const t = now();
+    const continuous = signal?.mode === 'continuous';
+    lastMode = continuous ? 'continuous' : 'demand';
+    watchForStill();
+    if (continuous) {
+      lastMotionAt = t;
+      if (sharp) {
+        // This frame was the sharp one and the next one resizes: neither
+        // says anything about the rung's speed.
+        unsharpen(t, signal);
+        startOver(t);
+        lastContinuousAt = null;
+        return;
+      }
+    }
+    const gap = lastContinuousAt === null ? Infinity : t - lastContinuousAt;
+    if (continuous && gap < PAUSE_MS) {
+      intervals.push(gap);
+      work.push({ cpuMs: Number(signal.cpuMs) || 0, gpuMs: signal.gpuMs });
+    } else {
+      // The animation stopped and started again (or only drew on demand).
+      startOver(t);
+    }
+    lastContinuousAt = continuous ? t : null;
+    if (t - windowStart >= 1000) evaluate(t);
+  }
+
+  apply('start');
+  const off = quality.signals.on('frame', onFrame);
+  // Nothing may ever move (a parked globe): the first still is sharp too.
+  watchForStill();
+
+  return {
+    /** What the governor is doing, for the diagnostics readout and QA. */
+    state: () => ({
+      level,
+      rungs: LADDER.length,
+      ...LADDER[level],
+      targetFps,
+      ...measured,
+      probing: trial?.kind === 'up',
+      trying: trial?.kind ?? null,
+      held,
+      sharpStill: sharp,
+      sharpStillOff: now() < stillOffUntil,
+      ceiling: ceilingNow(now()),
+      floor: floorNow(now()),
+      changes,
+    }),
+    /**
+     * Put the governor on a rung (QA and the device test). With `hold` it
+     * stays there, measuring and deciding nothing, until the next call
+     * without it.
+     */
+    setLevel(next, { hold = false } = {}) {
+      trial = null;
+      held = Boolean(hold);
+      moveTo(clampLevel(next), now(), 'pinned');
+      watchForStill();
+    },
+    /**
+     * The scene is another one (a mission was picked): what the last one
+     * taught about which rungs are worth trying no longer holds.
+     */
+    newScene() {
+      const t = now();
+      ceilingUntil = 0;
+      floorUntil = 0;
+      ceilingBackoff = BACKOFF_MS;
+      floorBackoff = BACKOFF_MS;
+      if (trial) {
+        // An unjudged step is not kept on trust.
+        const { from } = trial;
+        trial = null;
+        moveTo(from, t, 'new-scene');
+      }
+      startOver(t);
+    },
+    /**
+     * Whether a still picture may be sharpened. Turned off while something
+     * is changing the view in steps, so the pauses between its steps are not
+     * taken for stillness; turned back on, the wait for stillness starts over.
+     */
+    allowStills(allowed) {
+      stillsAllowed = Boolean(allowed);
+      if (stillsAllowed) {
+        lastMotionAt = now();
+        watchForStill();
+      }
+    },
+    stop() {
+      stopped = true;
+      if (stillTimer !== null) cancel(stillTimer);
+      stillTimer = null;
+      off?.();
+    },
+  };
+}
diff --git a/src/tablet/governor.test.mjs b/src/tablet/governor.test.mjs
new file mode 100644
index 0000000..6fb0e70
--- /dev/null
+++ b/src/tablet/governor.test.mjs
@@ -0,0 +1,518 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  LADDER,
+  QUALITY_STORAGE_KEY,
+  STILL_AFTER_MS,
+  createQualityGovernor,
+  readStoredLevel,
+} from './governor.js';
+
+/**
+ * A quality port that records what it is set to, a clock and timers to drive,
+ * and a device to draw on: `run` draws frames as far apart as the device takes
+ * at the resolution the governor has set. A device's frame costs `cpuMs`
+ * whatever the resolution, plus `gpuMs` at full resolution, less with fewer
+ * pixels; no frame comes sooner than the 30 fps cap allows.
+ */
+function harness({
+  startLevel = 2,
+  stored = null,
+  targetFps = 30,
+  stillPixelRatio = 1,
+  device = { cpuMs: 5, gpuMs: 10 },
+} = {}) {
+  let t = 0;
+  let listener = null;
+  const sets = [];
+  let pixelRatio = 1;
+  let timers = [];
+  let scene = { ...device };
+  /** Moves the clock to `to`, running the timers that fall due on the way. */
+  const moveTo = (to) => {
+    for (;;) {
+      const due = timers
+        .filter((timer) => timer.at <= to)
+        .sort((a, b) => a.at - b.at)[0];
+      if (!due) break;
+      timers = timers.filter((timer) => timer !== due);
+      t = Math.max(t, due.at);
+      due.fn();
+    }
+    t = to;
+  };
+  const store = new Map(stored === null ? [] : [[QUALITY_STORAGE_KEY, stored]]);
+  const storage = {
+    getItem: (k) => (store.has(k) ? store.get(k) : null),
+    setItem: (k, v) => store.set(k, v),
+  };
+  const quality = {
+    set: (s) => {
+      sets.push(s);
+      if (s.pixelRatio !== undefined) pixelRatio = s.pixelRatio;
+    },
+    signals: {
+      on: (event, cb) => {
+        listener = cb;
+        return () => {
+          listener = null;
+        };
+      },
+    },
+  };
+  const changes = [];
+  const governor = createQualityGovernor({
+    quality,
+    targetFps,
+    startLevel,
+    now: () => t,
+    storage,
+    stillPixelRatio,
+    onChange: (change) => changes.push(change.reason),
+    schedule: (fn, ms) => {
+      const timer = { at: t + ms, fn };
+      timers.push(timer);
+      return timer;
+    },
+    cancel: (timer) => {
+      timers = timers.filter((other) => other !== timer);
+    },
+  });
+  /** How far apart the device's frames come at the resolution now set. */
+  const frameMs = () =>
+    Math.max(1000 / targetFps, scene.cpuMs + scene.gpuMs * pixelRatio ** 2);
+  /**
+   * Animate for `seconds`: frames `ms` apart when given, else as the device
+   * draws them.
+   */
+  const run = (seconds, ms = null, { mode = 'continuous' } = {}) => {
+    const end = t + seconds * 1000;
+    while (t < end) {
+      moveTo(t + (ms ?? frameMs()));
+      listener?.({ mode, cpuMs: scene.cpuMs });
+    }
+  };
+  /** One frame now, as the loop draws one when asked to. */
+  const frame = (mode = 'demand') => listener?.({ mode, cpuMs: scene.cpuMs });
+  return {
+    governor,
+    sets,
+    changes,
+    storage,
+    store,
+    run,
+    frame,
+    advance: (ms) => moveTo(t + ms),
+    /** Swap the device's load, as another scene would. */
+    load: (next) => (scene = { ...next }),
+    fps: () => 1000 / frameMs(),
+    pendingTimers: () => timers.length,
+  };
+}
+
+/** A chip that draws everything at the cap. */
+const STRONG = { cpuMs: 4, gpuMs: 8 };
+/** A graphics chip too slow for full resolution: fewer pixels help a lot. */
+const WEAK_GPU = { cpuMs: 8, gpuMs: 80 };
+/** A processor too slow, whatever the resolution. */
+const WEAK_CPU = { cpuMs: 75, gpuMs: 4 };
+
+/** What a still picture is set to: the stock app's own quality. */
+const STILL = { pixelRatio: 1, terrainDetail: 1, tiles3dDetail: 1 };
+/** What a rung sets while the picture moves. */
+const moving = (level) => ({
+  pixelRatio: LADDER[level].pixelRatio,
+  terrainDetail: LADDER[level].terrainDetail,
+  tiles3dDetail: LADDER[level].terrainDetail,
+});
+
+// --- The ladder and its memory ---------------------------------------------
+
+test('each rung is no sharper and no more detailed than the one above', () => {
+  for (let i = 1; i < LADDER.length; i++) {
+    assert.ok(LADDER[i].pixelRatio < LADDER[i - 1].pixelRatio);
+    assert.ok(LADDER[i].terrainDetail < LADDER[i - 1].terrainDetail);
+  }
+  assert.deepEqual({ ...LADDER[0] }, { pixelRatio: 1, terrainDetail: 1 });
+});
+
+test('starts on the starting rung with multisampling off and the frame cap on', () => {
+  const { governor, sets } = harness({ startLevel: 2 });
+  assert.equal(governor.state().level, 2);
+  assert.deepEqual(sets[0], {
+    pixelRatio: LADDER[2].pixelRatio,
+    terrainDetail: LADDER[2].terrainDetail,
+    tiles3dDetail: LADDER[2].terrainDetail,
+    msaa: 0,
+    targetFps: 30,
+  });
+});
+
+test('starts on the remembered rung', () => {
+  const { governor } = harness({ stored: JSON.stringify({ level: 4 }) });
+  assert.equal(governor.state().level, 4);
+});
+
+test('a broken or out-of-range memory is ignored or clamped', () => {
+  assert.equal(readStoredLevel({ getItem: () => '{nope' }), null);
+  assert.equal(
+    readStoredLevel({ getItem: () => '{"level":99}' }),
+    LADDER.length - 1,
+  );
+  assert.equal(readStoredLevel(null), null);
+});
+
+test('a pinned rung is applied and remembered', () => {
+  const { governor, sets, store } = harness({ startLevel: 2 });
+  governor.setLevel(5);
+  assert.equal(governor.state().level, 5);
+  assert.equal(sets.at(-1).pixelRatio, LADDER[5].pixelRatio);
+  assert.deepEqual(JSON.parse(store.get(QUALITY_STORAGE_KEY)), { level: 5 });
+});
+
+test('a rung that is held stays put, and one let go is tuned again', () => {
+  const { governor, run } = harness({ device: WEAK_GPU });
+  governor.setLevel(0, { hold: true });
+  run(120);
+  assert.equal(governor.state().level, 0);
+  assert.equal(governor.state().held, true);
+  governor.setLevel(0);
+  run(60);
+  assert.ok(governor.state().level > 0);
+});
+
+test('stopped, it changes nothing more', () => {
+  const { governor, run, sets } = harness({ device: WEAK_GPU });
+  governor.stop();
+  const before = sets.length;
+  run(60);
+  assert.equal(sets.length, before);
+});
+
+test('needs a quality port', () => {
+  assert.throws(() => createQualityGovernor({ quality: null }), TypeError);
+});
+
+// --- A graphics chip that is too slow: fewer pixels help --------------------
+
+test('steps down when frames stay slow, and remembers the rung', () => {
+  const { governor, run, store } = harness({ device: WEAK_GPU });
+  run(9); // past the start cooldown, then slow for long enough
+  assert.equal(governor.state().level, 3);
+  assert.deepEqual(JSON.parse(store.get(QUALITY_STORAGE_KEY)), { level: 3 });
+});
+
+test('a step down that makes the picture faster is kept', () => {
+  const { governor, run, changes, fps } = harness({ device: WEAK_GPU });
+  run(60);
+  assert.ok(governor.state().level >= 3);
+  assert.ok(!changes.includes('no-gain'));
+  assert.ok(fps() >= 30 * 0.72, `${fps()} fps`);
+});
+
+test('keeps stepping down while it helps, to the last rung at most', () => {
+  const { governor, run } = harness({ device: { cpuMs: 5, gpuMs: 400 } });
+  run(240);
+  assert.equal(governor.state().level, LADDER.length - 1);
+});
+
+test('one slow second is not enough to step down', () => {
+  const { governor, run } = harness({ device: STRONG });
+  run(6);
+  run(1.5, 70);
+  run(6);
+  assert.equal(governor.state().level, 2);
+});
+
+// --- A processor that is too slow: fewer pixels do not help -----------------
+
+test('a step down that buys nothing is taken back', () => {
+  const { governor, run, changes } = harness({ device: WEAK_CPU });
+  run(30);
+  assert.ok(changes.includes('no-gain'));
+  assert.ok(governor.state().level <= 2, `rung ${governor.state().level}`);
+  assert.ok(governor.state().floor <= 2);
+});
+
+test('where fewer pixels do not help, the picture is made sharper for free', () => {
+  const { governor, run, fps } = harness({ device: WEAK_CPU });
+  const before = fps();
+  run(240);
+  assert.equal(governor.state().level, 0);
+  assert.ok(fps() >= before * 0.9, `${before} -> ${fps()} fps`);
+});
+
+test('sharpness is not thrown away on a slow processor', () => {
+  const { governor, run } = harness({ device: WEAK_CPU });
+  let worst = 0;
+  for (let i = 0; i < 300; i++) {
+    run(1);
+    worst = Math.max(worst, governor.state().level);
+  }
+  assert.ok(worst <= 3, `went down to rung ${worst}`);
+});
+
+test('a step up that slows a slow picture further is taken back', () => {
+  // The processor is the main trouble, but pixels are not free either.
+  const { governor, run, changes } = harness({
+    device: { cpuMs: 50, gpuMs: 60 },
+    startLevel: 5,
+  });
+  run(300);
+  assert.ok(changes.includes('too-much'));
+  assert.ok(governor.state().level >= 3, `rung ${governor.state().level}`);
+});
+
+// --- A chip with room to spare ----------------------------------------------
+
+test('tries a better rung after a long steady spell with time to spare', () => {
+  const { governor, run } = harness({ startLevel: 3, device: STRONG });
+  run(30);
+  assert.equal(governor.state().level, 2);
+  assert.equal(governor.state().probing, true);
+});
+
+test('a better rung that holds is kept, and it can climb again', () => {
+  const { governor, run } = harness({ startLevel: 3, device: STRONG });
+  run(120);
+  assert.ok(governor.state().level <= 1, `rung ${governor.state().level}`);
+});
+
+test('never climbs past the best rung', () => {
+  const { governor, run } = harness({ startLevel: 1, device: STRONG });
+  run(400);
+  assert.equal(governor.state().level, 0);
+});
+
+test('does not try a better rung while the processor is nearly spent', () => {
+  const { governor, run } = harness({
+    startLevel: 3,
+    device: { cpuMs: 28, gpuMs: 2 },
+  });
+  run(60);
+  assert.equal(governor.state().level, 3);
+});
+
+test('a better rung that costs frame rate is taken back, and left alone for longer each time', () => {
+  // On target at rung 3, too slow at rung 2.
+  const { governor, run, changes } = harness({
+    startLevel: 3,
+    device: { cpuMs: 4, gpuMs: 72 },
+  });
+  run(40);
+  assert.ok(changes.includes('too-much'));
+  assert.equal(governor.state().level, 3);
+  assert.equal(governor.state().ceiling, 3);
+  const tries = () => changes.filter((reason) => reason === 'probe').length;
+  assert.equal(tries(), 1);
+  run(240); // inside the first back-off (5 minutes)
+  assert.equal(tries(), 1);
+  run(120); // past it: tried again, and failed again
+  assert.equal(tries(), 2);
+  run(420); // the back-off has doubled (10 minutes)
+  assert.equal(tries(), 2);
+  assert.equal(governor.state().level, 3);
+});
+
+// --- Pauses, and scenes that change -----------------------------------------
+
+test('frames drawn on demand are ignored', () => {
+  const { governor, run } = harness({ startLevel: 2 });
+  run(60, 200, { mode: 'demand' });
+  assert.equal(governor.state().level, 2);
+  assert.equal(governor.state().fps, null);
+});
+
+test('a pause between frames is not a slow frame', () => {
+  const { governor, run, advance } = harness({ device: STRONG });
+  run(6);
+  for (let i = 0; i < 20; i++) {
+    advance(3000); // the screen was off, or nothing moved
+    run(0.3);
+  }
+  assert.equal(governor.state().level, 2);
+});
+
+test('a new scene opens the rungs the last one closed', () => {
+  const { governor, run, load } = harness({ device: WEAK_CPU });
+  run(30); // learns that stepping down does not help here
+  assert.ok(governor.state().floor < LADDER.length - 1);
+  load(WEAK_GPU);
+  governor.newScene();
+  assert.equal(governor.state().floor, LADDER.length - 1);
+  const from = governor.state().level;
+  run(60);
+  assert.ok(governor.state().level > from, 'steps down where it now helps');
+});
+
+test('a step not yet judged is not kept across a change of scene', () => {
+  const { governor, run } = harness({ device: WEAK_GPU });
+  run(9);
+  assert.equal(governor.state().level, 3);
+  assert.equal(governor.state().trying, 'down');
+  governor.newScene();
+  assert.equal(governor.state().level, 2);
+  assert.equal(governor.state().trying, null);
+});
+
+// --- Sharp when still --------------------------------------------------------
+
+test('a still picture is redrawn at the stock resolution and detail', () => {
+  const { governor, sets, advance } = harness({ startLevel: 2 });
+  assert.equal(governor.state().sharpStill, false);
+  advance(STILL_AFTER_MS + 1);
+  assert.equal(governor.state().sharpStill, true);
+  assert.deepEqual(sets.at(-1), STILL);
+  assert.equal(governor.state().level, 2); // the rung itself has not moved
+});
+
+test('movement brings the rung resolution back, and stillness the sharp one', () => {
+  const { governor, sets, run, advance, frame } = harness({ device: STRONG });
+  advance(2000);
+  assert.equal(governor.state().sharpStill, true);
+  run(3);
+  assert.equal(governor.state().sharpStill, false);
+  assert.deepEqual(sets.at(-1), moving(2));
+  const setsWhileMoving = sets.length;
+  run(3);
+  assert.equal(sets.length, setsWhileMoving); // nothing is set frame by frame
+  frame(); // the loop's settling frame, drawn on demand
+  advance(STILL_AFTER_MS + 1);
+  assert.equal(governor.state().sharpStill, true);
+  assert.deepEqual(sets.at(-1), STILL);
+});
+
+test('an animation whose frames come far apart is not stillness', () => {
+  const { governor, run } = harness({ startLevel: 2 });
+  run(60, 1200); // under one frame a second, and still animating
+  assert.equal(governor.state().sharpStill, false);
+  assert.equal(governor.state().sharpStillOff, false);
+});
+
+test('an animation that just stops, with no frame after it, is left alone', () => {
+  const { governor, run, advance } = harness({ device: STRONG });
+  run(2);
+  advance(10_000);
+  assert.equal(governor.state().sharpStill, false);
+});
+
+test('a short pause in the movement is not stillness', () => {
+  const { governor, run, advance } = harness({ device: STRONG });
+  run(2);
+  for (let i = 0; i < 10; i++) {
+    advance(STILL_AFTER_MS - 200);
+    run(0.5);
+    assert.equal(governor.state().sharpStill, false);
+  }
+});
+
+test('frames drawn on demand do not undo the sharp still', () => {
+  const { governor, run, advance } = harness({ startLevel: 2 });
+  advance(2000);
+  run(5, 250, { mode: 'demand' });
+  assert.equal(governor.state().sharpStill, true);
+});
+
+test('the sharp frame and the resize after it are not timed', () => {
+  const { governor, run, advance, frame } = harness({ device: STRONG });
+  run(6); // past the start cooldown
+  for (let i = 0; i < 12; i++) {
+    frame(); // the settling frame
+    advance(2000); // still: sharp
+    assert.equal(governor.state().sharpStill, true);
+    run(0.27, 90); // slow frames as movement starts on the sharp picture
+    run(2); // then on target
+  }
+  assert.equal(governor.state().level, 2);
+});
+
+test('the best rung has nothing sharper to redraw at', () => {
+  const { governor, sets, advance } = harness({ startLevel: 0 });
+  const before = sets.length;
+  advance(5000);
+  assert.equal(governor.state().sharpStill, false);
+  assert.equal(sets.length, before);
+});
+
+test('sharp-when-still can be turned off', () => {
+  const { governor, advance } = harness({ startLevel: 3, stillPixelRatio: 0 });
+  advance(5000);
+  assert.equal(governor.state().sharpStill, false);
+});
+
+test('a rung pinned while still is sharpened again', () => {
+  const { governor, sets, advance } = harness({ startLevel: 2 });
+  advance(2000);
+  governor.setLevel(4);
+  assert.equal(governor.state().sharpStill, false);
+  assert.equal(sets.at(-1).pixelRatio, LADDER[4].pixelRatio);
+  advance(STILL_AFTER_MS + 1);
+  assert.equal(governor.state().sharpStill, true);
+});
+
+test('sharpening that keeps setting the picture moving is left off for a while', () => {
+  const { governor, run, advance, frame } = harness({ device: STRONG });
+  run(1);
+  frame(); // it settles
+  for (let i = 0; i < 3; i++) {
+    advance(STILL_AFTER_MS + 1);
+    assert.equal(governor.state().sharpStill, true);
+    advance(50);
+    frame('continuous'); // movement right after sharpening
+    assert.equal(governor.state().sharpStill, false);
+    frame(); // and it settles again
+  }
+  assert.equal(governor.state().sharpStillOff, true);
+  advance(60_000);
+  assert.equal(governor.state().sharpStill, false);
+  advance(5 * 60_000);
+  frame('continuous');
+  frame();
+  advance(STILL_AFTER_MS + 1);
+  assert.equal(governor.state().sharpStill, true);
+});
+
+test('movement that now and then follows a sharpening is not a fault', () => {
+  const { governor, advance, frame } = harness({ startLevel: 2 });
+  for (let i = 0; i < 12; i++) {
+    advance(STILL_AFTER_MS + 1);
+    assert.equal(governor.state().sharpStill, true);
+    advance(50);
+    frame('continuous'); // straight after, as a mission's next step might be
+    frame();
+    advance(20_000); // but not again for a good while
+  }
+  assert.equal(governor.state().sharpStillOff, false);
+});
+
+test('nothing is sharpened while stills are not allowed', () => {
+  const { governor, run, advance, frame } = harness({ device: STRONG });
+  run(1);
+  frame();
+  governor.allowStills(false);
+  advance(10_000);
+  assert.equal(governor.state().sharpStill, false);
+  governor.allowStills(true);
+  advance(STILL_AFTER_MS - 100);
+  assert.equal(governor.state().sharpStill, false); // the wait starts over
+  advance(200);
+  assert.equal(governor.state().sharpStill, true);
+});
+
+test('movement a while after sharpening is only movement', () => {
+  const { governor, advance, frame } = harness({ startLevel: 2 });
+  for (let i = 0; i < 8; i++) {
+    advance(STILL_AFTER_MS + 600);
+    assert.equal(governor.state().sharpStill, true);
+    frame('continuous');
+    frame();
+  }
+  assert.equal(governor.state().sharpStillOff, false);
+});
+
+test('stopped, it leaves no timer waiting', () => {
+  const { governor, run, pendingTimers } = harness({ device: STRONG });
+  run(1);
+  governor.stop();
+  assert.equal(pendingTimers(), 0);
+});
