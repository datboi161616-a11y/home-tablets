+/**
+ * @module tablet/missions/catalog
+ * @description The Missions menu's choices: things to see, in plain words.
+ * Each one sets the app up through the app's own actions (the same ones voice
+ * and share links use), so a mission is exactly what a person could do by hand
+ * in the full controls, and nothing in the app is changed or left out.
+ *
+ * A mission says what it needs, and the runner (`./index.js`) does it in order:
+ *
+ * - `before(ctx)`: steps to take first (fly somewhere).
+ * - `context`: one of the app's own modes that picks its layers and camera
+ *   (`contacts`, `space-missions`); or
+ * - `layers`: exactly the data layers to show.
+ * - `after(ctx)`: any further steps (fly somewhere, follow something). One
+ *   that resolves to `false` could not do what the mission is for.
+ * - `takesOver`: the mission opens one of the app's full-screen experiences;
+ *   the value is the class the app puts on the body while it runs.
+ * - `then`: the mission the app is left in when that experience is closed by
+ *   its own controls (none: the menu opens again).
+ * - `sorry`: what to say when the mission could not do its part.
+ * - `card: false`: the app's card about what is in view stays shut.
+ * - `changesLook`: the experience restyles the app and leaves it restyled
+ *   (a film's recipe does); the runner puts the look back afterwards.
+ *
+ * `ctx` is:
+ * - `run(name, args)`: the app's action runner. It resolves to the action's
+ *   result, never throws, and does nothing once another mission was picked.
+ * - `home`: `{lat, lon}` of the tablet when the launcher passed it; else the
+ *   place the app itself starts over; null when neither is known.
+ * - `until(test, {tries, everyMs})`: wait for something to become true.
+ */
+
+/** The camera over the tablet's own spot, when it is known. */
+const overHome = (home, rangeM) =>
+  home
+    ? { latitude: home.lat, longitude: home.lon, rangeM, waitForArrival: true }
+    : null;
+
+/** Somewhere sensible to look at radar and radio when home is not known. */
+const NORTH_AMERICA = Object.freeze({
+  latitude: 39,
+  longitude: -96,
+  rangeM: 5_500_000,
+  waitForArrival: true,
+});
+
+/** Where to turn the Earth to when home is not known: the Pacific's rim. */
+const PACIFIC_RIM = Object.freeze({ lat: 35, lon: -150 });
+
+/**
+ * The whole Earth, turned to a place. The app's globe view shows the side the
+ * camera is over, so the camera goes there first.
+ */
+async function wholeEarthOver(run, place) {
+  await run('fly_to_location', {
+    latitude: place.lat,
+    longitude: place.lon,
+    rangeM: 3_000_000,
+    waitForArrival: true,
+  });
+  await run('zoom_to_globe', {});
+}
+
+export const MISSIONS = Object.freeze([
+  {
+    id: 'planes',
+    art: 'plane',
+    title: 'Planes in the sky',
+    blurb: 'Every aircraft near you, live. Follow one across the map.',
+    tip: 'Each plane is a real aircraft, a few seconds behind real life. Tap a plane to follow it. Drag to look around, pinch to zoom.',
+    context: 'contacts',
+    async before({ run, home }) {
+      const near = overHome(home, 250_000);
+      if (near) await run('fly_to_location', near);
+    },
+  },
+  {
+    id: 'cockpit',
+    card: false,
+    art: 'cockpit',
+    title: 'Ride in the cockpit',
+    blurb: 'See the view from a real flight that is in the air right now.',
+    tip: 'You are riding along with a real flight. The dials show its real speed and height. Open Missions to pick something else.',
+    sorry:
+      'No flight to ride along with just now. Try again in a minute, or pick Planes in the sky.',
+    context: 'contacts',
+    takesOver: 'cockpit-mode',
+    then: 'planes',
+    async before({ run, home }) {
+      const near = overHome(home, 250_000);
+      if (near) await run('fly_to_location', near);
+    },
+    async after({ run, until }) {
+      // The cockpit opens once a plane is being followed: an airliner for
+      // choice, and whatever is being followed when there is none.
+      const enter = async (args) =>
+        (await run('control_cockpit', { action: 'enter', ...args }))?.ok ===
+        true;
+      return (
+        (await until(() => enter({ targetLayer: 'flights' }), {
+          tries: 6,
+          everyMs: 1500,
+        })) || until(() => enter({}), { tries: 6, everyMs: 1500 })
+      );
+    },
+  },
+  {
+    id: 'station',
+    art: 'station',
+    title: 'The space station',
+    blurb: 'Follow the International Space Station around the Earth.',
+    tip: 'Astronauts live aboard. It circles the Earth every 90 minutes at about 17,500 mph. The line shows where it is heading.',
+    sorry:
+      'The space station could not be found just now. Check the Wi-Fi, then pick it again.',
+    layers: ['satellites'],
+    async after({ run, until }) {
+      await run('zoom_to_globe', {});
+      return until(
+        async () =>
+          (await run('track_entity', { query: 'ISS', layerId: 'satellites' }))
+            ?.ok === true,
+        { tries: 15, everyMs: 1500 },
+      );
+    },
+  },
+  {
+    id: 'launches',
+    art: 'rocket',
+    title: 'Rocket launches',
+    blurb: 'Recent launches and the ones coming up, at their launch pads.',
+    tip: 'Each marker is a rocket launch from the last month or one coming up. Tap one in the list to read about it.',
+    context: 'space-missions',
+    async before({ run, home }) {
+      // The side of the Earth with the launch pads nearest home.
+      if (home) await wholeEarthOver(run, home);
+    },
+  },
+  {
+    id: 'quakes',
+    art: 'quake',
+    title: 'Earthquakes today',
+    blurb: 'Every sizeable earthquake of the last 24 hours, worldwide.',
+    tip: 'Each marker is an earthquake from the last day. The number is its strength: M5 is strong. The card on the right counts them by size.',
+    layers: ['earthquakes'],
+    async after({ run, home }) {
+      await wholeEarthOver(run, home ?? PACIFIC_RIM);
+    },
+  },
+  {
+    id: 'weather',
+    art: 'storm',
+    title: 'Storms and rain',
+    blurb: 'Live rain radar, clouds from space, and named storms.',
+    tip: 'Colours show where it is raining now. Named storms show the path they are forecast to take.',
+    layers: ['weather-radar', 'weather-satellite', 'weather-cyclones'],
+    async after({ run, home }) {
+      await run('fly_to_location', overHome(home, 2_500_000) ?? NORTH_AMERICA);
+    },
+  },
+  {
+    id: 'military',
+    art: 'jet',
+    title: 'Military aircraft',
+    blurb: 'Tankers, transports and trainers that broadcast where they are.',
+    tip: 'These are military aircraft that share their position publicly. Tap one to follow it.',
+    layers: ['military'],
+    async after({ run, home }) {
+      await run('fly_to_location', overHome(home, 2_500_000) ?? NORTH_AMERICA);
+    },
+  },
+  {
+    id: 'cameras',
+    card: false,
+    art: 'camera',
+    title: 'Live street cameras',
+    blurb: 'Look through public traffic cameras in cities around the world.',
+    tip: 'This is a public traffic camera. Use Prev and Next for others nearby, or tap a camera marker on the map. It can take a little while to load.',
+    sorry: 'No camera answered just now. Pick it again in a minute.',
+    layers: ['cctv'],
+    async after({ run, until }) {
+      await run('fly_to_location', {
+        locationId: 'nyc',
+        viewMode: 'close',
+        waitForArrival: true,
+      });
+      // The camera list fills in a while after the layer turns on.
+      return until(
+        async () =>
+          (await run('control_cctv', { action: 'nearest' }))?.ok === true,
+        { tries: 20, everyMs: 2000 },
+      );
+    },
+  },
+  {
+    id: 'radio',
+    art: 'radio',
+    title: 'Radio around the world',
+    blurb: 'Listen to live local radio stations anywhere on Earth.',
+    tip: 'Each marker is a radio station. Tap one to listen. Spin the globe to try another country.',
+    layers: ['radio'],
+    async after({ run, home }) {
+      await run('fly_to_location', overHome(home, 2_500_000) ?? NORTH_AMERICA);
+      // The player, ready before a station is picked.
+      await run('set_panel_open', { panelId: 'radio-panel', open: true });
+    },
+  },
+  {
+    id: 'stories',
+    card: false,
+    art: 'story',
+    title: 'Guided stories',
+    blurb: 'Sit back: short guided tours of things happening on Earth.',
+    tip: '',
+    layers: [],
+    takesOver: 'stories-mode',
+    async after({ run }) {
+      await run('open_stories', {});
+    },
+  },
+  {
+    id: 'show',
+    card: false,
+    art: 'show',
+    title: 'Sit back and watch',
+    blurb: 'A short film made live from real flights around the world.',
+    tip: 'This plays by itself. Open Missions when you want to take over.',
+    layers: [],
+    takesOver: 'scene-playback-mode',
+    changesLook: true,
+    async after({ run }) {
+      await run('control_scene', { action: 'play', sceneId: 'flights-radar' });
+    },
+  },
+  {
+    id: 'explore',
+    card: false,
+    art: 'globe',
+    title: 'Just explore',
+    blurb: 'A clean globe. Spin it, zoom in, or search for any place.',
+    tip: 'Drag to spin the globe and pinch to zoom. Use the search box at the bottom to fly to any place.',
+    layers: [],
+    async after({ run, home }) {
+      if (home) await wholeEarthOver(run, home);
+      else await run('zoom_to_globe', {});
+    },
+  },
+]);
+
+/** The words on the stock screens, in plain English. */
+export const GLOSSARY = Object.freeze([
+  [
+    'FL390',
+    'Flight level: the height in hundreds of feet. FL390 is 39,000 feet.',
+  ],
+  ['kts', 'Knots, the speed aircraft and ships use. 480 kts is about 550 mph.'],
+  [
+    'STALE',
+    'The last position report is a little old. The plane is still there.',
+  ],
+  [
+    'B38M, A320…',
+    'A short code for the type of aircraft. B38M is a Boeing 737 MAX 8.',
+  ],
+  [
+    'SQUAWK',
+    'A four-digit code a plane sends so controllers can tell it apart.',
+  ],
+  [
+    'ADS-B',
+    'The radio signal aircraft send out with their position. It is public.',
+  ],
+  ['AIS', 'The same idea for ships.'],
+  ['ISS', 'The International Space Station.'],
+  [
+    'M 4.5',
+    'An earthquake’s strength. Above 4 can be felt; above 6 does damage.',
+  ],
+  ['CCTV', 'Public street and traffic cameras.'],
+  [
+    'TOP SECRET…',
+    'Decoration, for the spy-movie look. Everything shown here is public.',
+  ],
+  [
+    'MGRS, GSD, NIIRS',
+    'Map-maker readouts about the spot under the crosshair. Safe to ignore.',
+  ],
+]);
