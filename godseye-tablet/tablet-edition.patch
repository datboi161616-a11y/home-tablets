+/**
+ * @module tablet/profile
+ * @description The tablet edition's switch. This fork exists to run the whole app
+ * on a small kitchen-counter tablet (Lenovo Tab M10 FHD Plus class: eight
+ * Cortex-A53 cores, a PowerVR GE8320, 2 GB of memory, 1920x1200 shown as
+ * 1280x800 CSS pixels). The tablet build turns the edition on; `?tablet=0`
+ * gives the stock app for comparison, and `?tablet=1` turns it on in any build.
+ *
+ * Nothing here removes a feature. The edition changes starting values (lighter
+ * graphics, a calmer HUD), adds a quality governor that keeps the frame rate up
+ * by trading sharpness, and adds a plain-language Missions menu.
+ */
+
+/**
+ * Whether this build is the tablet build (`GEV_TABLET=1 vite build`, see
+ * `build/vite.js`). A stock build, the dev server without the variable and
+ * the unit tests under Node all read false, and behave as the stock app.
+ */
+const BUILT_FOR_TABLET =
+  typeof import.meta.env !== 'undefined' && import.meta.env.GEV_TABLET === true;
+
+/** Whether the tablet edition is on for this page. */
+export function tabletEdition(location = globalThis.location) {
+  // A panel page that loads the app into itself keeps the stock behaviour.
+  if (globalThis.GEV_EMBED_INLINE === true) return false;
+  try {
+    const flag = new URLSearchParams(location?.search || '').get('tablet');
+    if (flag === '0') return false;
+    if (flag === '1') return true;
+  } catch {
+    /* no location: the build decides */
+  }
+  return BUILT_FOR_TABLET;
+}
+
+/**
+ * Whether the page was opened fresh, read as this module loads and before the
+ * app writes its own state into the link. A link that already carries display
+ * settings (a share link, or a reload of a page in use) holds someone's
+ * choices; a fresh start gets the tablet's lighter starting values.
+ */
+export const startedFresh = (() => {
+  try {
+    return !/(?:^|[#&])sharpen=/.test(String(globalThis.location?.hash || ''));
+  } catch {
+    return true;
+  }
+})();
+
+/** Whether the page was asked to show the governor's numbers (`?tabletdiag=1`). */
+export function tabletDiagnostics(location = globalThis.location) {
+  try {
+    return (
+      new URLSearchParams(location?.search || '').get('tabletdiag') === '1'
+    );
+  } catch {
+    return false;
+  }
+}
+
+/** Whether another page frames the app as a bare globe (`?embed=1`). */
+export function framedGlobe(location = globalThis.location) {
+  try {
+    return new URLSearchParams(location?.search || '').get('embed') === '1';
+  } catch {
+    return false;
+  }
+}
+
+/** Mark the document, so `tablet.css` can restyle the stock chrome. */
+export function markDocument(doc = globalThis.document) {
+  if (!tabletEdition() || !doc?.documentElement) return;
+  doc.documentElement.classList.add('tablet-edition');
+}
+
+/** Multisampling the viewer starts with: none on the tablet, the app's 4 otherwise. */
+export const startingMsaa = () => (tabletEdition() ? 0 : 4);
diff --git a/src/tablet/startRetry.js b/src/tablet/startRetry.js
