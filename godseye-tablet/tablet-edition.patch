index 0000000..5c89da3
--- /dev/null
+++ b/src/tablet/index.js
@@ -0,0 +1,159 @@
+/**
+ * @module tablet
+ * @description The tablet edition, installed once the application's scene and
+ * tools exist (`createApplicationTools` in `src/app/tools.js` calls it):
+ *
+ * - lighter starting values (`defaults.js`; the limits a 2 GB device needs
+ *   are set where the viewer is made, `render/cesium/applicationViewer.js`);
+ * - the quality governor (`governor.js`), over the renderer's quality port;
+ * - the Missions menu and simple mode (`missions/`), unless another page
+ *   frames the app as a bare globe.
+ *
+ * Everything is additive: `?tablet=0` gives the stock app.
+ */
+import './tablet.css';
+import { applyStartingValues } from './defaults.js';
+import { createQualityGovernor } from './governor.js';
+import { installMissions } from './missions/index.js';
+import {
+  framedGlobe,
+  markDocument,
+  tabletDiagnostics,
+  tabletEdition,
+} from './profile.js';
+
+/** `localStorage`, or null where reading it throws (private modes). */
+function safeStorage() {
+  try {
+    return globalThis.localStorage ?? null;
+  } catch {
+    return null;
+  }
+}
+
+/** The page's script memory, where the browser says (Chromium does). */
+function memoryNote() {
+  const memory = globalThis.performance?.memory;
+  if (!memory?.usedJSHeapSize) return '';
+  const mb = (bytes) => Math.round(bytes / 1048576);
+  return ` · mem ${mb(memory.usedJSHeapSize)} of ${mb(memory.jsHeapSizeLimit)} MB`;
+}
+
+/** A small corner readout of what the governor is doing (`?tabletdiag=1`). */
+function installReadout(governor, doc = globalThis.document) {
+  const el = doc.createElement('div');
+  el.className = 'tablet-diag';
+  el.setAttribute('aria-hidden', 'true');
+  doc.body.appendChild(el);
+  const words = (s) => {
+    const n = (v, d = 0) => (Number.isFinite(v) ? v.toFixed(d) : '--');
+    const trying = { up: ' · trying sharper', down: ' · trying softer' };
+    return (
+      `quality ${s.level + 1}/${s.rungs} · ${Math.round(s.pixelRatio * 100)}% sharp · ` +
+      `${n(s.fps)} fps · cpu ${n(s.cpuMs, 1)} ms` +
+      (Number.isFinite(s.gpuMs) ? ` · gpu ${n(s.gpuMs, 1)} ms` : '') +
+      (trying[s.trying] ?? '') +
+      (s.sharpStill ? ' · still: full quality' : '') +
+      memoryNote()
+    );
+  };
+  const draw = () => {
+    el.textContent = words(governor.state());
+  };
+  const timer = setInterval(draw, 1000);
+  draw();
+  return () => {
+    clearInterval(timer);
+    el.remove();
+  };
+}
+
+/**
+ * @param {object} options
+ * @param {object} options.viewer The Cesium viewer.
+ * @param {object} options.renderer The scene's renderer (its `quality` port).
+ * @param {object} options.dataManager
+ * @param {(name: string, args?: object, options?: object) => Promise<object>}
+ *   options.run The app's action runner.
+ * @param {{isOpen: () => boolean, close: () => void}|null} [options.stories]
+ *   The app's Stories screens, for a mission to close them on the way in.
+ * @param {AbortSignal} [options.signal]
+ * @returns {() => void} Remove everything the edition added.
+ */
+export function installTabletEdition({
+  viewer,
+  renderer,
+  dataManager,
+  run,
+  stories = null,
+  signal,
+}) {
+  if (!tabletEdition()) return () => {};
+  markDocument();
+  const storage = safeStorage();
+  const cleanups = [];
+
+  let governor = null;
+  /** The governor's latest changes, for QA and the device test. */
+  const changes = [];
+  if (renderer?.quality?.signals) {
+    try {
+      governor = createQualityGovernor({
+        quality: renderer.quality,
+        storage,
+        onChange: (change) => {
+          changes.push({ at: Math.round(performance.now()), ...change });
+          if (changes.length > 60) changes.shift();
+        },
+      });
+      cleanups.push(() => governor.stop());
+      if (tabletDiagnostics()) cleanups.push(installReadout(governor));
+    } catch (error) {
+      console.warn('Tablet quality governor unavailable:', error);
+    }
+  }
+
+  let missions = null;
+  if (!framedGlobe()) {
+    missions = installMissions({
+      dataManager,
+      run,
+      stories,
+      storage,
+      signal,
+      // The pauses between a mission's steps are not a still picture, and
+      // the mission it ends on is another scene to tune for.
+      onBusy: (busy) => {
+        governor?.allowStills(!busy);
+        if (!busy) governor?.newScene();
+      },
+    });
+    cleanups.push(missions.remove);
+  }
+
+  // The starting values (on a fresh start), then the menu: the menu's own settings
+  // (simple mode hides the HUD) come after them.
+  applyStartingValues({ run })
+    .catch(() => false)
+    .then(() => missions?.ready());
+
+  // For QA and the device test: what the edition is doing.
+  const handle = { governor, missions, changes };
+  globalThis.__gevTablet = handle;
+  cleanups.push(() => {
+    if (globalThis.__gevTablet === handle) delete globalThis.__gevTablet;
+  });
+
+  let removed = false;
+  return () => {
+    if (removed) return;
+    removed = true;
+    for (const cleanup of cleanups.reverse()) {
+      try {
+        cleanup();
+      } catch {
+        /* one failing must not keep the rest */
+      }
+    }
+  };
+}
