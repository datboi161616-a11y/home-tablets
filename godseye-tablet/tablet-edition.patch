+++ b/src/tablet/startRetry.js
@@ -0,0 +1,54 @@
+/**
+ * @module tablet/startRetry
+ * @description A start that fails (a file that did not arrive over weak
+ * Wi-Fi, say) leaves the stock app on its loading screen with an error, which
+ * is fine at a desk where someone presses reload. A tablet on a kitchen
+ * counter has no reload button, so the tablet edition reloads by itself, at
+ * most `MAX_RETRIES` times in a row, waiting a little longer each time.
+ */
+import { tabletEdition } from './profile.js';
+
+export const START_RETRY_KEY = 'gev:tablet:start-retries:v1';
+export const MAX_RETRIES = 3;
+const FIRST_WAIT_MS = 2000;
+
+function session() {
+  try {
+    return globalThis.sessionStorage ?? null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Schedule a reload after a failed start.
+ * @returns {boolean} Whether a reload is on its way (false: show the error).
+ */
+export function retryStart({
+  storage = session(),
+  reload = () => globalThis.location?.reload(),
+  schedule = (fn, ms) => setTimeout(fn, ms),
+  enabled = tabletEdition(),
+} = {}) {
+  if (!enabled || !storage) return false;
+  let tries = 0;
+  try {
+    tries = Number(storage.getItem(START_RETRY_KEY)) || 0;
+    if (tries >= MAX_RETRIES) return false;
+    storage.setItem(START_RETRY_KEY, String(tries + 1));
+  } catch {
+    // Without a count there is no stopping, so do not start.
+    return false;
+  }
+  schedule(reload, FIRST_WAIT_MS * (tries + 1));
+  return true;
+}
+
+/** A start that worked: the next failure gets its full set of retries. */
+export function clearStartRetries({ storage = session() } = {}) {
+  try {
+    storage?.removeItem(START_RETRY_KEY);
+  } catch {
+    /* nothing to clear */
+  }
+}
diff --git a/src/tablet/tablet.css b/src/tablet/tablet.css
new file mode 100644
index 0000000..5ab1455
--- /dev/null
+++ b/src/tablet/tablet.css
@@ -0,0 +1,402 @@
+/* ── Tablet edition ─────────────────────────────────────────────────────────
+   Everything here hangs off `html.tablet-edition` (set by src/tablet/profile.js),
+   so the stock app is untouched when the edition is off.
+
+   1. Cheaper compositing for a weak graphics chip.
+   2. Simple mode: the stock cockpit tucked away behind "All controls".
+   3. The Missions menu, the mission bar and the plain-English sheet.
+   ─────────────────────────────────────────────────────────────────────────── */
+
+/* ── 1. Cheaper compositing ──────────────────────────────────────────────────
+   The stock panels are frosted glass: each one blurs the globe behind it
+   (`backdrop-filter: blur(24px)`), which a desktop GPU does without noticing.
+   A PowerVR GE8320 has to re-blur every panel each time the globe redraws, so
+   the tablet gets solid panels instead: the same shape and colour, no blur. */
+html.tablet-edition {
+  --glass-bg: rgba(12, 14, 22, 0.94);
+  --glass-strong: rgba(12, 14, 22, 0.97);
+  --tm-panel: #0c1018;
+  --tm-panel-edge: rgba(0, 212, 255, 0.34);
+  --tm-ink: #e8eaed;
+  --tm-ink-soft: #a9b6c2;
+  --tm-accent: var(--accent, #00d4ff);
+  --tm-accent-ink: #04141b;
+}
+
+html.tablet-edition *,
+html.tablet-edition *::before,
+html.tablet-edition *::after {
+  -webkit-backdrop-filter: none !important;
+  backdrop-filter: none !important;
+}
+
+/* A kitchen screen in kiosk mode has no browser to go to: a link that leads
+   off the app (a photo's credit, a station's home page, a map provider) would
+   leave it stranded on a page with no way back. The names stay readable. */
+html.tablet-edition a[href^='http'] {
+  pointer-events: none !important;
+}
+
+/* ── 2. Simple mode ──────────────────────────────────────────────────────────
+   Hidden the way the app's own clean view hides things (still laid out, so
+   nothing that measures them breaks), and brought back by "All controls". */
+html.tablet-simple #title-bar,
+html.tablet-simple #style-indicator,
+html.tablet-simple #top-center-actions,
+html.tablet-simple #pp-toggles,
+html.tablet-simple #param-slider-panel,
+html.tablet-simple #control-panel,
+html.tablet-simple #left-panel-stack,
+html.tablet-simple #left-panel-rail,
+html.tablet-simple #intel-hud,
+html.tablet-simple #corner-actions,
+html.tablet-simple #gev-voice-control,
+html.tablet-simple #view-switcher,
+html.tablet-simple #orbit-indicator,
+html.tablet-simple #safe-frame-overlay,
+html.tablet-simple #hStories,
+html.tablet-simple #hPop {
+  opacity: 0 !important;
+  visibility: hidden !important;
+  pointer-events: none !important;
+}
+
+/* The right-hand rail stays. The app opens a panel there when it has
+   something to say about what was tapped or is being followed (a plane's
+   card, a camera's picture, the radio), and that is the part worth reading.
+   It sits below the mission bar and above the search box, without the
+   switcher between its panels. */
+html.tablet-simple body:not(.cockpit-mode) #right-context-rail {
+  top: 104px !important;
+  right: 12px !important;
+  max-height: calc(100vh - 104px - 124px) !important;
+  max-height: calc(100dvh - 104px - 124px) !important;
+}
+
+html.tablet-simple #right-context-rail > .gev-panel-rail,
+html.tablet-simple #right-context-rail > #weather-panel,
+html.tablet-simple #right-context-rail > #news-panel,
+html.tablet-simple #right-context-rail > #recent-imagery-panel,
+html.tablet-simple #right-context-rail > #street-level-panel,
+/* Of the Context panel: the card and the lists, not the tools around them. */
+html.tablet-simple #global-context-panel .context-dock-btn,
+html.tablet-simple #right-context-rail .panel-edge-btn,
+html.tablet-simple #global-context-panel .context-tabs,
+html.tablet-simple #global-context-panel .global-context-modes,
+html.tablet-simple #global-context-panel #context-mode-standby,
+html.tablet-simple #global-context-panel #installations-search-btn,
+html.tablet-simple #global-context-panel #tr3b-toggle,
+/* The assistant needs an account key the tablet does not have. */
+html.tablet-simple #global-context-panel .entity-card__action--ask,
+/* Of the radio: the station, the dial and the buttons that play it; and
+   only where the radio is what is being looked at. */
+html.tablet-simple:not([data-tm-mission='radio']) #radio-panel,
+/* The radio's own card names the station; the map's card for it only has
+   the station's catalogue number. */
+html.tablet-simple[data-tm-mission='radio'] #entity-card,
+html.tablet-simple #radio-panel .radio-directory-row,
+html.tablet-simple #radio-panel .radio-links,
+html.tablet-simple #radio-panel .radio-privacy,
+html.tablet-simple #radio-panel #sdr-radio-card,
+/* Of the camera panel: the picture, where it is, and the buttons that move
+   between cameras; the calibration tools stay behind "All controls". */
+html.tablet-simple #cctv-panel .cctv-controls ~ .cctv-controls ~ .cctv-controls,
+html.tablet-simple #cctv-panel .cctv-calibration-block,
+html.tablet-simple #cctv-panel .cctv-summary-label,
+html.tablet-simple #cctv-panel #cctv-summary {
+  display: none !important;
+}
+
+/* ── 3. Missions ─────────────────────────────────────────────────────────── */
+.tm-root {
+  font-family: var(--font-sans, 'Inter', sans-serif);
+  color: var(--tm-ink);
+}
+
+.tm-root [hidden] {
+  display: none !important;
+}
+
+.tm-icon {
+  display: inline-flex;
+  flex: none;
+}
+
+/* The mission bar. In simple mode it is the top of the screen; with all
+   controls showing it shrinks to a pill above the stock toolbar. */
+.tm-bar {
+  position: fixed;
+  top: 12px;
+  left: 12px;
+  right: 12px;
+  z-index: 1150;
+  display: flex;
+  align-items: stretch;
+  gap: 10px;
+  pointer-events: none;
+}
+
+.tm-bar > * {
+  pointer-events: auto;
+}
+
+.tm-button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  min-height: 56px;
+  padding: 0 20px;
+  border: 1px solid var(--tm-panel-edge);
+  border-radius: 14px;
+  background: var(--tm-panel);
+  color: var(--tm-ink);
+  font: 600 17px/1 var(--font-sans, 'Inter', sans-serif);
+  letter-spacing: 0.01em;
+  white-space: nowrap;
+  flex: none;
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+  touch-action: manipulation;
+}
+
+.tm-button:active {
+  background: #142230;
+}
+
+.tm-button-main {
+  border-color: transparent;
+  background: var(--tm-accent);
+  color: var(--tm-accent-ink);
+  font-size: 18px;
+}
+
+.tm-button-main:active {
+  background: #6fe6ff;
+}
+
+.tm-button-round {
+  width: 56px;
+  padding: 0;
+}
+
+.tm-button[aria-pressed='true'] {
+  border-color: var(--tm-accent);
+  color: var(--tm-accent);
+}
+
+.tm-now {
+  flex: 1 1 auto;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  gap: 3px;
+  padding: 8px 18px;
+  border: 1px solid var(--tm-panel-edge);
+  border-radius: 14px;
+  background: var(--tm-panel);
+}
+
+.tm-now-title {
+  font: 600 17px/1.2 var(--font-sans, 'Inter', sans-serif);
+  color: var(--tm-accent);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.tm-now-tip {
+  font: 400 15px/1.3 var(--font-sans, 'Inter', sans-serif);
+  color: var(--tm-ink);
+  display: -webkit-box;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+  overflow: hidden;
+}
+
+.tm-now-tip:empty {
+  display: none;
+}
+
+.tm-busy .tm-now-tip {
+  color: var(--tm-ink-soft);
+}
+
+/* All controls showing: the stock title, toolbar and panels own the edges, so
+   the bar becomes a small pill in the empty strip at the very top. */
+html.tablet-edition:not(.tablet-simple) .tm-bar {
+  top: 6px;
+  left: 50%;
+  right: auto;
+  transform: translateX(-50%);
+  gap: 6px;
+}
+
+html.tablet-edition:not(.tablet-simple) .tm-now {
+  display: none;
+}
+
+html.tablet-edition:not(.tablet-simple) .tm-button {
+  min-height: 44px;
+  padding: 0 14px;
+  border-radius: 22px;
+  font-size: 15px;
+}
+
+html.tablet-edition:not(.tablet-simple) .tm-button-round {
+  width: 44px;
+  padding: 0;
+}
+
+/* The film plays on a clean screen: only the way back to the menu stays.
+   Stories has its own screens and its own way back, and a recording is of
+   the globe alone; a sheet covers the bar. */
+body.scene-playback-mode .tm-bar > :not(.tm-button-main),
+body.recording-mode:not(.scene-playback-mode) .tm-bar,
+body.stories-mode .tm-bar {
+  display: none;
+}
+
+html.tablet-sheet-open .tm-bar {
+  visibility: hidden;
+}
+
+/* Sheets: the menu and the plain-English page. */
+.tm-sheet {
+  position: fixed;
+  inset: 0;
+  z-index: 1300;
+  display: flex;
+  flex-direction: column;
+  gap: 18px;
+  padding: 28px max(28px, calc((100vw - 1180px) / 2)) 22px;
+  /* Solid: nothing behind a sheet has to be blended, or shows through. */
+  background: #05080d;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
+
+.tm-sheet-head {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 16px;
+}
+
+.tm-eyebrow {
+  font: 500 13px/1 var(--font-mono, monospace);
+  letter-spacing: 0.22em;
+  text-transform: uppercase;
+  color: var(--tm-accent);
+}
+
+.tm-sheet-title {
+  margin-top: 10px;
+  font: 600 38px/1.1 var(--font-sans, 'Inter', sans-serif);
+  letter-spacing: -0.01em;
+  color: var(--tm-ink);
+}
+
+.tm-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 14px;
+}
+
+.tm-card {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 12px;
+  min-height: 158px;
+  padding: 18px 18px 16px;
+  border: 1px solid rgba(255, 255, 255, 0.1);
+  border-radius: 18px;
+  background: #0f1620;
+  color: var(--tm-ink);
+  text-align: left;
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+  touch-action: manipulation;
+}
+
+.tm-card .tm-icon {
+  color: var(--tm-accent);
+}
+
+.tm-card:active {
+  border-color: var(--tm-accent);
+  background: #13222f;
+}
+
+.tm-card-words {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.tm-card-title {
+  font: 600 20px/1.2 var(--font-sans, 'Inter', sans-serif);
+}
+
+.tm-card-blurb {
+  font: 400 15px/1.35 var(--font-sans, 'Inter', sans-serif);
+  color: var(--tm-ink-soft);
+}
+
+.tm-sheet-foot {
+  font: 400 15px/1.4 var(--font-sans, 'Inter', sans-serif);
+  color: var(--tm-ink-soft);
+}
+
+.tm-glossary {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 10px 28px;
+}
+
+.tm-glossary-row {
+  display: grid;
+  grid-template-columns: 150px 1fr;
+  gap: 14px;
+  align-items: baseline;
+  padding: 10px 0;
+  border-top: 1px solid rgba(255, 255, 255, 0.09);
+}
+
+.tm-glossary dt {
+  font: 500 15px/1.3 var(--font-mono, monospace);
+  color: var(--tm-accent);
+}
+
+.tm-glossary dd {
+  font: 400 16px/1.4 var(--font-sans, 'Inter', sans-serif);
+  color: var(--tm-ink);
+}
+
+/* The governor's numbers (`?tabletdiag=1`). */
+.tablet-diag {
+  position: fixed;
+  left: 12px;
+  bottom: 12px;
+  z-index: 370;
+  padding: 6px 10px;
+  border-radius: 8px;
+  background: rgba(0, 0, 0, 0.78);
+  color: #9ef0b4;
+  font: 500 13px/1.2 var(--font-mono, monospace);
+  pointer-events: none;
+}
+
+@media (max-width: 900px) {
+  .tm-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .tm-glossary {
+    grid-template-columns: 1fr;
+  }
+  .tm-sheet-title {
+    font-size: 28px;
+  }
+}
