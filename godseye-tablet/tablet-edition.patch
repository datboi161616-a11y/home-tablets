+/**
+ * @module tablet/missions/icons
+ * @description Line icons for the Missions menu, drawn here so the menu
+ * needs no extra font or image. 48x48, stroked in the current colour.
+ */
+
+const PATHS = {
+  plane:
+    '<path d="M24 5c2 0 3 2 3 5v9l15 9v4l-15-4v9l5 4v3l-8-2-8 2v-3l5-4v-9L6 32v-4l15-9v-9c0-3 1-5 3-5z"/>',
+  cockpit:
+    '<path d="M6 30a18 18 0 0 1 36 0"/><path d="M6 30v8h36v-8"/><path d="M24 30l7-9"/><circle cx="24" cy="30" r="2.5"/><path d="M12 30h3M33 30h3M24 15v3"/>',
+  station:
+    '<rect x="19" y="19" width="10" height="10" rx="2"/><path d="M19 24H7M29 24h12"/><rect x="5" y="15" width="6" height="18"/><rect x="37" y="15" width="6" height="18"/><path d="M24 19v-7M24 29v7M20 12h8M20 36h8"/>',
+  rocket:
+    '<path d="M24 4c7 6 9 15 7 26H17C15 19 17 10 24 4z"/><circle cx="24" cy="17" r="3.5"/><path d="M17 26l-6 9 7-2M31 26l6 9-7-2"/><path d="M21 34v6M27 34v6M24 35v9"/>',
+  quake: '<path d="M3 26h8l4-12 6 24 5-18 4 10 3-4h12"/>',
+  storm:
+    '<path d="M14 30a9 9 0 0 1 2-17.6A12 12 0 0 1 39 16a8 8 0 0 1-2 14"/><path d="M25 24l-6 9h8l-5 10"/>',
+  jet: '<path d="M24 4l4 16 16 12v4l-16-5-1 7 5 4v2h-16v-2l5-4-1-7-16 5v-4l16-12z"/>',
+  camera:
+    '<rect x="5" y="14" width="26" height="20" rx="3"/><path d="M31 21l12-6v18l-12-6"/><circle cx="14" cy="24" r="3"/>',
+  radio:
+    '<rect x="6" y="18" width="36" height="22" rx="3"/><path d="M12 18L34 7"/><circle cx="17" cy="29" r="5"/><path d="M28 25h9M28 30h9M28 35h5"/>',
+  story:
+    '<path d="M8 9h13a4 4 0 0 1 3 2 4 4 0 0 1 3-2h13v28H27a4 4 0 0 0-3 2 4 4 0 0 0-3-2H8z"/><path d="M24 11v28"/>',
+  show: '<rect x="5" y="9" width="38" height="26" rx="3"/><path d="M20 16l10 6-10 6z"/><path d="M16 41h16"/>',
+  globe:
+    '<circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c-9 9-9 27 0 36M24 6c9 9 9 27 0 36"/>',
+  menu: '<path d="M8 13h32M8 24h32M8 35h32"/>',
+  help: '<circle cx="24" cy="24" r="18"/><path d="M18 19a6 6 0 1 1 9 5c-2 1-3 2-3 5"/><circle cx="24" cy="35" r="1.5" fill="currentColor"/>',
+  close: '<path d="M11 11l26 26M37 11L11 37"/>',
+  sliders:
+    '<path d="M8 14h32M8 24h32M8 34h32"/><circle cx="17" cy="14" r="4" fill="var(--tm-panel)"/><circle cx="31" cy="24" r="4" fill="var(--tm-panel)"/><circle cx="21" cy="34" r="4" fill="var(--tm-panel)"/>',
+};
+
+/** An icon as an SVG element. */
+export function icon(name, size = 48, doc = globalThis.document) {
+  // A mission names its drawing `art` (`catalog.js`): in this app `icon:` is
+  // a glyph of the icon font, checked against the font's subset.
+  const holder = doc.createElement('span');
+  holder.className = 'tm-icon';
+  holder.setAttribute('aria-hidden', 'true');
+  // Fixed strings from this file only; no outside text reaches the markup.
+  holder.innerHTML = `<svg viewBox="0 0 48 48" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">${PATHS[name] || PATHS.globe}</svg>`;
+  return holder;
+}
