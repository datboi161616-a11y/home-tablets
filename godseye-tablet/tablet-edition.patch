+/**
+ * @module tablet/missions
+ * @description The Missions menu and simple mode: a plain-language front door
+ * for someone who thinks the globe is cool and has no idea where to start.
+ *
+ * - **Missions**: a screen of big choices ("Planes in the sky", "The space
+ *   station"…). Picking one sets the app up through its own actions and puts
+ *   a one-line explanation of what is on screen in the mission bar.
+ * - **Simple mode** (on by default): the stock cockpit's rails, readouts and
+ *   toolbars are hidden, leaving the globe, its labels, the search box, the
+ *   mission bar and the app's own card about what was tapped or is followed.
+ *   **All controls** brings every stock control back; nothing is removed,
+ *   only tucked away (`../tablet.css`).
+ * - The full-screen experiences (the cockpit, Stories, a film) have their own
+ *   ways out; the bar follows them, and puts back the look a film changed.
+ * - **What does this mean?**: the jargon on the stock screens, in plain words.
+ *
+ * The view is plain DOM (no framework state to keep in step with the app's).
+ */
+import { GLOSSARY, MISSIONS } from './catalog.js';
+import { icon } from './icons.js';
+
+export const SIMPLE_STORAGE_KEY = 'gev:tablet:simple:v1';
+export const HOME_STORAGE_KEY = 'gev:tablet:home:v1';
+
+const sleep = (ms, signal) =>
+  new Promise((resolve) => {
+    const timer = setTimeout(resolve, ms);
+    signal?.addEventListener(
+      'abort',
+      () => {
+        clearTimeout(timer);
+        resolve();
+      },
+      { once: true },
+    );
+  });
+
+/**
+ * The tablet's own position, when the page that opened the app passed it
+ * (`?home=<lat>,<lon>`); remembered, so a later start without it still knows.
+ * @returns {{lat: number, lon: number}|null}
+ */
+export function readHome(location = globalThis.location, storage = null) {
+  const parse = (text) => {
+    const [lat, lon] = String(text || '')
+      .split(',')
+      .map(Number);
+    return Number.isFinite(lat) &&
+      Number.isFinite(lon) &&
+      Math.abs(lat) <= 90 &&
+      Math.abs(lon) <= 180
+      ? { lat, lon }
+      : null;
+  };
+  let fromLink = null;
+  try {
+    fromLink = parse(new URLSearchParams(location?.search || '').get('home'));
+  } catch {
+    /* no location */
+  }
+  try {
+    if (fromLink)
+      storage?.setItem?.(HOME_STORAGE_KEY, `${fromLink.lat},${fromLink.lon}`);
+    return fromLink ?? parse(storage?.getItem?.(HOME_STORAGE_KEY));
+  } catch {
+    return fromLink;
+  }
+}
+
+/** A mission named in the link (`?mission=planes`), to start without the menu. */
+function linkedMission(location = globalThis.location) {
+  try {
+    const id = new URLSearchParams(location?.search || '').get('mission');
+    return MISSIONS.find((m) => m.id === id) ?? null;
+  } catch {
+    return null;
+  }
+}
+
+function el(doc, tag, className, text) {
+  const node = doc.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+
+/**
+ * @param {object} options
+ * @param {object} options.dataManager
+ * @param {(name: string, args?: object) => Promise<object>} options.run
+ * @param {{isOpen: () => boolean, close: () => void}|null} [options.stories]
+ * @param {(busy: boolean) => void} [options.onBusy] Told when a mission
+ *   starts setting the app up, and when the last one to start has finished.
+ * @param {{getItem: Function, setItem: Function}|null} [options.storage]
+ * @param {AbortSignal} [options.signal]
+ * @returns {{ready: () => void, remove: () => void, open: () => void,
+ *   choose: (id: string) => Promise<void>, state: () => object}}
+ */
+export function installMissions({
+  dataManager,
+  run,
+  stories = null,
+  onBusy = null,
+  storage = null,
+  signal,
+  doc = globalThis.document,
+}) {
+  const root = doc.documentElement;
+  const linkedHome = readHome(globalThis.location, storage);
+  /** Where the app itself starts over, read once it is up (`ready`). */
+  let startPlace = null;
+  const homePlace = () => linkedHome ?? startPlace;
+  let current = null;
+  let sequence = 0;
+  let simple = true;
+  try {
+    simple = storage?.getItem?.(SIMPLE_STORAGE_KEY) !== 'off';
+  } catch {
+    /* keep simple mode */
+  }
+
+  // --- Running a mission -----------------------------------------------------
+  /** The app's action runner: resolves to the result and never throws. */
+  const act = async (name, args = {}) => {
+    try {
+      return (await run(name, args)) ?? { ok: true };
+    } catch (error) {
+      return { ok: false, error: error?.message || String(error) };
+    }
+  };
+
+  /**
+   * A film dresses the app up (its recipe picks a visual style, glow,
+   * sharpening and so on) and leaves it that way when it ends. This is the
+   * look from just before one started, put back when the film is over or left.
+   * `restoreLook` resolves to the look it put back, or null with none to.
+   */
+  let lookBefore = null;
+  const lookOf = (state) =>
+    state?.controls
+      ? {
+          style: state.style,
+          bloom: state.controls.bloom,
+          sharpen: state.controls.sharpen,
+          detection: state.controls.detection,
+          hud: state.controls.hud?.layout,
+        }
+      : null;
+  async function restoreLook(step = act) {
+    const was = lookBefore;
+    lookBefore = null;
+    if (!was) return null;
+    if (was.style) await step('set_visual_style', { style: was.style });
+    await step('set_post_processing', {
+      bloom: {
+        enabled: Boolean(was.bloom?.enabled),
+        intensityPct: was.bloom?.intensityPct ?? 0,
+      },
+      sharpen: { enabled: Boolean(was.sharpen?.enabled) },
+    });
+    const mode = String(was.detection?.detectionMode ?? '').toLowerCase();
+    await step('set_detection', {
+      enabled: mode !== 'off',
+      ...(['sparse', 'balanced', 'dense'].includes(mode) ? { mode } : {}),
+      ...(Number.isFinite(was.detection?.densityPct)
+        ? { densityPct: was.detection.densityPct }
+        : {}),
+    });
+    if (was.hud) await step('set_hud', { layout: was.hud });
+    return was;
+  }
+
+  /**
+   * Set the app up for `mission`, a step at a time. Every step checks `alive`
+   * first, so a mission that was replaced while it was still setting up (they
+   * can take a while: flights, cameras loading) stops where it is instead of
+   * carrying on underneath the new one. `leaving` is the mission before it.
+   * @returns {Promise<boolean>} False when the mission could not do its part.
+   */
+  async function setUp(mission, alive, leaving) {
+    const step = (name, args) =>
+      alive()
+        ? act(name, args)
+        : Promise.resolve({ ok: false, superseded: true });
+    const until = async (test, { tries = 10, everyMs = 1000 } = {}) => {
+      for (let i = 0; i < tries; i++) {
+        if (!alive()) return false;
+        if (await test()) return true;
+        await sleep(everyMs, signal);
+      }
+      return false;
+    };
+    const ctx = { run: step, until, home: homePlace(), signal };
+
+    // Leave whatever the last mission left running.
+    if (leaving?.id === 'radio')
+      await step('control_radio', { action: 'stop' });
+    if (stories?.isOpen()) {
+      stories.close();
+      // Closed at once, but the app goes on putting its own view back for a
+      // moment, and would undo a step taken meanwhile.
+      await until(
+        () => !stories.isOpen() && !doc.body.classList.contains('stories-mode'),
+        { tries: 24, everyMs: 250 },
+      );
+      await sleep(300, signal);
+    }
+    const state = await step('get_current_view_state', {});
+    if (state?.cockpit?.active)
+      await step('control_cockpit', { action: 'exit' });
+    if (state?.scenePlayback?.running)
+      await step('control_scene', { action: 'stop' });
+    // The look to come back to is the one from before any film: `state` was
+    // read while the last film's look was still on.
+    const restored = await restoreLook(step);
+    if (mission.changesLook) lookBefore = restored ?? lookOf(state);
+
+    // One of the app's own modes that is already on stays as it is, with the
+    // plane it follows: the cockpit and the planes it flies among share one.
+    const sameContext =
+      Boolean(mission.context) &&
+      state?.context?.active === true &&
+      state.context.mode === mission.context;
+    if (!sameContext) {
+      if (state?.context?.active)
+        await step('set_context_mode', { mode: 'off' });
+      await step('stop_tracking', {});
+      await mission.before?.(ctx);
+
+      // The data on the map: exactly the mission's layers, or none before one
+      // of the app's modes, which then brings its own.
+      const wanted = new Set(mission.context ? [] : (mission.layers ?? []));
+      for (const layer of dataManager.getAll())
+        if (alive() && layer.enabled && !wanted.has(layer.id))
+          await step('set_layer_visibility', {
+            layerId: layer.id,
+            enabled: false,
+          });
+      for (const layerId of wanted)
+        if (alive() && !dataManager.isEnabled(layerId))
+          await step('set_layer_visibility', { layerId, enabled: true });
+      if (mission.context)
+        await step('set_context_mode', { mode: mission.context });
+    }
+
+    const done = (await mission.after?.(ctx)) !== false;
+    // The app's own card about what is in view or being followed, beside
+    // the map: open where it has something to say, shut for a clean screen.
+    await step('set_panel_open', {
+      panelId: 'global-context-panel',
+      open: mission.card !== false,
+    });
+    return done;
+  }
+
+  // --- The view --------------------------------------------------------------
+  const host = el(doc, 'div', 'tm-root');
+  host.setAttribute('data-tablet-missions', '');
+
+  const bar = el(doc, 'div', 'tm-bar');
+  const menuButton = el(doc, 'button', 'tm-button tm-button-main');
+  menuButton.type = 'button';
+  menuButton.append(icon('menu', 26, doc), el(doc, 'span', '', 'Missions'));
+  const now = el(doc, 'div', 'tm-now');
+  now.setAttribute('role', 'status');
+  now.setAttribute('aria-live', 'polite');
+  const nowTitle = el(doc, 'div', 'tm-now-title', 'God’s Eye View');
+  const nowTip = el(doc, 'div', 'tm-now-tip', '');
+  now.append(nowTitle, nowTip);
+  const controlsButton = el(doc, 'button', 'tm-button');
+  controlsButton.type = 'button';
+  const controlsLabel = el(doc, 'span', '');
+  controlsButton.append(icon('sliders', 24, doc), controlsLabel);
+  const helpButton = el(doc, 'button', 'tm-button tm-button-round');
+  helpButton.type = 'button';
+  helpButton.setAttribute('aria-label', 'What do the words on screen mean?');
+  helpButton.append(icon('help', 26, doc));
+  bar.append(menuButton, now, controlsButton, helpButton);
+
+  const menu = el(doc, 'div', 'tm-sheet tm-menu');
+  menu.setAttribute('role', 'dialog');
+  menu.setAttribute('aria-modal', 'true');
+  menu.setAttribute('aria-label', 'Missions');
+  menu.hidden = true;
+  const menuHead = el(doc, 'div', 'tm-sheet-head');
+  const menuTitles = el(doc, 'div', '');
+  menuTitles.append(
+    el(doc, 'div', 'tm-eyebrow', 'God’s Eye View'),
+    el(doc, 'h2', 'tm-sheet-title', 'What would you like to see?'),
+  );
+  const menuClose = el(doc, 'button', 'tm-button tm-button-round');
+  menuClose.type = 'button';
+  menuClose.setAttribute('aria-label', 'Close the menu');
+  menuClose.append(icon('close', 24, doc));
+  menuHead.append(menuTitles, menuClose);
+  const grid = el(doc, 'div', 'tm-grid');
+  for (const mission of MISSIONS) {
+    const card = el(doc, 'button', 'tm-card');
+    card.type = 'button';
+    card.dataset.mission = mission.id;
+    const words = el(doc, 'span', 'tm-card-words');
+    words.append(
+      el(doc, 'span', 'tm-card-title', mission.title),
+      el(doc, 'span', 'tm-card-blurb', mission.blurb),
+    );
+    card.append(icon(mission.art, 44, doc), words);
+    grid.append(card);
+  }
+  const menuFoot = el(
+    doc,
+    'div',
+    'tm-sheet-foot',
+    'Everything here is real and live. Come back to this menu any time with the Missions button.',
+  );
+  menu.append(menuHead, grid, menuFoot);
+
+  const help = el(doc, 'div', 'tm-sheet tm-help');
+  help.setAttribute('role', 'dialog');
+  help.setAttribute('aria-modal', 'true');
+  help.setAttribute('aria-label', 'What the words mean');
+  help.hidden = true;
+  const helpHead = el(doc, 'div', 'tm-sheet-head');
+  const helpTitles = el(doc, 'div', '');
+  helpTitles.append(
+    el(doc, 'div', 'tm-eyebrow', 'Plain English'),
+    el(doc, 'h2', 'tm-sheet-title', 'What do the words mean?'),
+  );
+  const helpClose = el(doc, 'button', 'tm-button tm-button-round');
+  helpClose.type = 'button';
+  helpClose.setAttribute('aria-label', 'Close');
+  helpClose.append(icon('close', 24, doc));
+  helpHead.append(helpTitles, helpClose);
+  const list = el(doc, 'dl', 'tm-glossary');
+  for (const [term, meaning] of GLOSSARY) {
+    const row = el(doc, 'div', 'tm-glossary-row');
+    row.append(el(doc, 'dt', '', term), el(doc, 'dd', '', meaning));
+    list.append(row);
+  }
+  const moving = el(doc, 'div', 'tm-sheet-foot');
+  moving.textContent =
+    'Getting around: drag to move, pinch to zoom, two fingers to tilt and turn. Tap anything on the map to learn about it.';
+  help.append(helpHead, list, moving);
+
+  host.append(bar, menu, help);
+
+  // --- Behaviour -------------------------------------------------------------
+  function drawSimple() {
+    root.classList.toggle('tablet-simple', simple);
+    controlsLabel.textContent = simple ? 'All controls' : 'Simple view';
+    controlsButton.setAttribute('aria-pressed', String(!simple));
+  }
+  function setSimple(next) {
+    simple = Boolean(next);
+    try {
+      storage?.setItem?.(SIMPLE_STORAGE_KEY, simple ? 'on' : 'off');
+    } catch {
+      /* not remembered */
+    }
+    drawSimple();
+  }
+  const sheetOpen = () => !menu.hidden || !help.hidden;
+  function show(sheet) {
+    menu.hidden = sheet !== menu;
+    help.hidden = sheet !== help;
+    root.classList.toggle('tablet-sheet-open', sheetOpen());
+    if (sheet)
+      (
+        sheet.querySelector('.tm-card') ?? sheet.querySelector('button')
+      )?.focus();
+  }
+
+  /** Put `mission` (or none) in the bar, without setting the app up for it. */
+  function adopt(mission, tip = mission?.tip ?? '') {
+    current = mission;
+    if (mission) root.setAttribute('data-tm-mission', mission.id);
+    else root.removeAttribute('data-tm-mission');
+    nowTitle.textContent = mission?.title ?? 'God’s Eye View';
+    nowTip.textContent = tip;
+  }
+
+  let busy = false;
+  /**
+   * The stock full-screen experience the current mission opened (the cockpit,
+   * Stories, the film), marked by a class on the body. Each has its own way
+   * out, and the film ends by itself: the bar follows.
+   */
+  let takeover = null;
+  function followTakeover() {
+    if (busy) return;
+    if (!takeover) {
+      // Opened from the app's own screens (the Cockpit button on a plane's
+      // card): the bar says so, and knows the way back.
+      const entered = MISSIONS.find(
+        (m) =>
+          m.takesOver &&
+          m.then === current?.id &&
+          doc.body.classList.contains(m.takesOver),
+      );
+      if (entered) {
+        adopt(entered);
+        takeover = { mission: entered, mark: entered.takesOver, seen: true };
+      }
+      return;
+    }
+    if (doc.body.classList.contains(takeover.mark)) {
+      takeover.seen = true;
+      return;
+    }
+    if (!takeover.seen) return;
+    const ended = takeover.mission;
+    takeover = null;
+    if (current !== ended) return;
+    if (ended.changesLook) restoreLook();
+    const next = MISSIONS.find((m) => m.id === ended.then) ?? null;
+    adopt(next);
+    if (!next) show(menu);
+  }
+  const bodyWatch =
+    typeof MutationObserver === 'function'
+      ? new MutationObserver(followTakeover)
+      : null;
+  bodyWatch?.observe(doc.body, {
+    attributes: true,
+    attributeFilter: ['class'],
+  });
+
+  async function choose(id) {
+    const mission = MISSIONS.find((m) => m.id === id);
+    if (!mission) return;
+    const mine = ++sequence;
+    const leaving = current;
+    show(null);
+    adopt(mission, 'Setting up…');
+    takeover = null;
+    busy = true;
+    bar.classList.add('tm-busy');
+    onBusy?.(true);
+    const alive = () => mine === sequence && !signal?.aborted;
+    let ok = false;
+    try {
+      ok = await setUp(mission, alive, leaving);
+    } catch {
+      /* told below */
+    }
+    if (!alive()) return; // another mission was picked meanwhile
+    busy = false;
+    bar.classList.remove('tm-busy');
+    onBusy?.(false);
+    nowTip.textContent = ok
+      ? mission.tip
+      : (mission.sorry ??
+        'That did not start. Check the Wi-Fi, then pick it again from Missions.');
+    if (ok && mission.takesOver) {
+      takeover = { mission, mark: mission.takesOver, seen: false };
+      followTakeover();
+    }
+  }
+
+  const onClick = (event) => {
+    const card = event.target.closest?.('.tm-card');
+    if (card) {
+      choose(card.dataset.mission);
+      return;
+    }
+    if (event.target === menu || event.target === help) show(null);
+  };
+  const onKey = (event) => {
+    if (event.key === 'Escape' && sheetOpen()) show(null);
+  };
+  menuButton.addEventListener('click', () => show(menu.hidden ? menu : null));
+  menuClose.addEventListener('click', () => show(null));
+  helpButton.addEventListener('click', () => show(help.hidden ? help : null));
+  helpClose.addEventListener('click', () => show(null));
+  controlsButton.addEventListener('click', () => setSimple(!simple));
+  host.addEventListener('click', onClick);
+  doc.addEventListener('keydown', onKey);
+
+  drawSimple();
+  doc.body.appendChild(host);
+
+  return {
+    /** The app has finished its own start: open the menu, or a linked mission. */
+    async ready() {
+      const view = await act('get_current_view_state', {});
+      const { latitude, longitude } = view?.camera ?? {};
+      if (Number.isFinite(latitude) && Number.isFinite(longitude))
+        startPlace = { lat: latitude, lon: longitude };
+      const linked = linkedMission();
+      if (linked) choose(linked.id);
+      else show(menu);
+    },
+    open: () => show(menu),
+    choose,
+    setSimple,
+    state: () => ({
+      mission: current?.id ?? null,
+      simple,
+      menuOpen: !menu.hidden,
+      home: homePlace(),
+    }),
+    remove() {
+      sequence += 1;
+      takeover = null;
+      bodyWatch?.disconnect();
+      doc.removeEventListener('keydown', onKey);
+      host.remove();
+      root.classList.remove('tablet-simple', 'tablet-sheet-open');
+      root.removeAttribute('data-tm-mission');
+    },
+  };
+}
